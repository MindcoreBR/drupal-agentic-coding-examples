<?xml version="1.0"?>
<ruleset name="Agentic coding examples">
  <description>Drupal and DrupalPractice standards for the example module.</description>
  <arg name="extensions" value="php,module,install,inc,test,profile,theme"/>
  <file>agentic_examples</file>
  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>
</ruleset>
